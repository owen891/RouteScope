# 前端对外端口（容器内 backend 仍是 8418，nginx 已下线，前端直接由 Go 嵌入 serve）
HTTP_PORT=8080

# 拉取的镜像 tag
IMAGE_TAG=latest

# Backend 运行模式 / 日志等级
SERVER_MODE=release
LOG_LEVEL=info

# 默认 SQLite 单文件。docker-compose.yml 已内置同样配置；这里主要给本地直跑或自定义覆盖用。
DATABASE_DRIVER=sqlite
DATABASE_PATH=/app/data/upstream-ops.db

# 叠加 docker-compose.mysql.yml 时使用这组 MySQL 参数
MYSQL_DATABASE=upstreamops
MYSQL_USER=upstreamops
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
# MySQL Compose requires both password variables; replace these placeholders before use.
MYSQL_PORT=33069

# 主密钥（任意长度，至少 32 字节随机串），用于 AES-GCM 加密敏感字段。
# **必填** — 修改后既有数据无法解密，请务必妥善保存。
APP_SECRET=please-change-me-to-a-long-random-secret-32bytes-min

# 鉴权开关。默认 false = 任何人访问 /api/* 都不需要登录（纯内网 / 反代后部署用）。
# 公网暴露请设 AUTH_ENABLED=true 并同时填好 ADMIN_PASSWORD。
AUTH_ENABLED=true

# 后台登录账号 / 密码。仅在 AUTH_ENABLED=true 时生效；AUTH_ENABLED=false 时可留空。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# token 签名密钥；留空时回退使用 APP_SECRET
AUTH_TOKEN_SECRET=


# 飞书自建应用控制通道。第一阶段仅启用回调、唯一账号绑定和卡片身份校验，
# 不会执行数据库接管、服务器关机或 Cloudflare DNS 修改。
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_CALLBACK_PATH=/callbacks/feishu
FEISHU_BIND_CODE_TTL_MINUTES=10
FEISHU_BIND_CODE_MAX_ATTEMPTS=5

# 推荐在宿主机创建 ./data/secrets/ 下的 0600 文件，并填写容器内路径；
# 未创建文件时保持为空，否则启动会因秘密文件不存在而失败。
FEISHU_APP_SECRET_FILE=
FEISHU_VERIFICATION_TOKEN_FILE=
FEISHU_ENCRYPT_KEY_FILE=
